# Quiet Alpha — environment variable NAMES (no real values here).
# Set real values in Railway → Service → Variables. Never commit secrets.

# --- Existing (unchanged) ---------------------------------------------
BOT_TOKEN=
SIGNAL_CHAT_ID=            # private channel that receives every card/output
PORT=                      # Railway; the webhook server listens here

# --- Owner (required; fail closed) --------------------------------------
OWNER_USER_ID=             # YOUR Telegram user id (positive number), not a chat id

# --- New secrets --------------------------------------------------------
UW_API_KEY=
TV_WEBHOOK_SECRET=         # long random string, also placed in the TradingView alert JSON
DATABASE_URL=              # reference from the Railway PostgreSQL service

# --- Master switch + feature flags (all default false) ------------------
AUTOMATION_ENABLED=false
TV_INTAKE_ENABLED=false
UW_WATCH_ENABLED=false
UW_WATCH_NOTIFY=false
MATCHING_ENABLED=false
SELECTION_ENABLED=false
PROPOSALS_ENABLED=false
TRACKING_ENABLED=false
MILESTONES_ENABLED=false
SUCCESS_CARD_ENABLED=false
HIGHEST_CARD_ENABLED=false

# --- Strategy settings: DEVELOPMENT / SHADOW DEFAULTS (optional overrides)
# Leave unset to use the defaults in automation/config.py. "none" disables a filter.
# UW_CHAIN_TICKERS=SPX,SPXW
# UW_WATCH_POLL_SECONDS=60
# UW_WATCH_WINDOW_MINUTES=5
# UW_WATCH_MIN_NET_PREMIUM=1000000
