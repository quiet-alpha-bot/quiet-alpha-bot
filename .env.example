# UW_WATCH_COOLDOWN_MINUTES=15
# MATCH_WINDOW_MINUTES=30
# MATCH_MIXED_POLICY=CONFLICT
# PREMIUM_MIN=2.50
# PREMIUM_MAX=4.00
# MAX_SPREAD_ABS=none
# MAX_SPREAD_PCT=none
# MIN_VOLUME=none
# MIN_OPEN_INTEREST=none
# DELTA_MIN_ABS=none
# DELTA_MAX_ABS=none
